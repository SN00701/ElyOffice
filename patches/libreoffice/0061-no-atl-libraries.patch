-$(eval $(call gb_Library_set_componentfile,emser,embedserv/util/emser,services))
 
 $(eval $(call gb_Library_set_include,emser,\
 	-I$(SRCDIR)/embedserv/source/inc \
-	-I$(ATL_INCLUDE) \
 	$$(INCLUDE) \
 ))
 
